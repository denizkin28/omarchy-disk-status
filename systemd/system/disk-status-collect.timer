[Unit]
Description=Refresh disk-status.json every 30 minutes

[Timer]
# Offset from the hour so we land after smartd's own 30-minute cycle rather
# than racing it for the same drives.
OnCalendar=*:07/30
Persistent=true
AccuracySec=1min
Unit=disk-status-collect.service

[Install]
WantedBy=timers.target
