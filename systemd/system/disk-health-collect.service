[Unit]
Description=Collect SMART state into disk-health.json
Documentation=man:smartd(8)
After=smartd.service
Wants=smartd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/disk-health-collect
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=300

# Root is needed for smartctl, but nothing else. Everything this writes lives
# under the state dir; the rest of the filesystem is read-only to it.
ProtectSystem=strict
ReadWritePaths=/var/lib/disk-health
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
